<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:HisaabKitaab.ViewModels"
             xmlns:views="using:HisaabKitaab.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="HisaabKitaab.Views.BankCashView"
             x:DataType="vm:BankCashViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.balance">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="32,24,32,16">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Theme="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{Binding Description}" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsBusy}" />
                <Button Theme="{StaticResource TransparentButton}" Command="{Binding PreviousMonthCommand}"
                        ToolTip.Tip="Previous month" AutomationProperties.Name="Previous month">
                    <ui:SymbolIcon Symbol="ChevronLeft" FontSize="16" />
                </Button>
                <TextBlock Text="{Binding MonthTitle}" Theme="{StaticResource SubtitleTextBlockStyle}"
                           MinWidth="180" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Theme="{StaticResource TransparentButton}" Command="{Binding NextMonthCommand}"
                        ToolTip.Tip="Next month" AutomationProperties.Name="Next month">
                    <ui:SymbolIcon Symbol="ChevronRight" FontSize="16" />
                </Button>
                <Button Content="This month" Command="{Binding GoToThisMonthCommand}" IsVisible="{Binding !IsCurrentMonth}" />
                <Button Command="{Binding ReloadCommand}" ToolTip.Tip="Reload from file" AutomationProperties.Name="Reload from file">
                    <ui:SymbolIcon Symbol="Refresh" FontSize="16" />
                </Button>
                <Button Command="{Binding OpenWorkbookCommand}" ToolTip.Tip="{Binding WorkbookName, StringFormat='Open {0}'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:SymbolIcon Symbol="OpenFile" FontSize="16" />
                        <TextBlock Text="Open in Excel" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The two balances -->
        <Grid Grid.Row="1" ColumnDefinitions="*,12,*" Margin="0,0,0,12">
            <Border Classes="card" Padding="20,14">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Classes="caption" Text="🏦 Bank balance" />
                    <TextBlock Grid.Row="1" Classes="balance" Text="{Binding BankBalanceText}"
                               Classes.negative="{Binding IsBankNegative}" />
                    <!-- Opening balance: click to set it yourself or go back to carrying it forward -->
                    <Button Grid.Row="2" Theme="{StaticResource TransparentButton}" Padding="4,2" Margin="-4,2,0,0"
                            HorizontalAlignment="Left" ToolTip.Tip="Change the opening balance">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding BankOpeningText}" FontSize="12" Opacity="0.8" />
                            <ui:SymbolIcon Symbol="Edit" FontSize="12" Opacity="0.8" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="280" Spacing="10">
                                    <TextBlock Text="Opening bank balance" FontWeight="SemiBold" />
                                    <TextBlock Text="Use the balance on your bank statement at the start of the month. Otherwise it follows last month's closing balance."
                                               TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                                    <ui:NumberBox Value="{Binding OpeningBankInput, Mode=TwoWay}" SpinButtonPlacementMode="Hidden"
                                                  AcceptsExpression="True" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Opening bank balance" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="accent" Content="Set" Command="{Binding SetBankOpeningCommand}" />
                                        <Button Content="Carry forward instead" Command="{Binding CarryBankOpeningCommand}"
                                                IsVisible="{Binding BankOpeningIsManual}" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding BankBreakdown}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="12" Opacity="0.7" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="card" Padding="20,14">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Classes="caption" Text="💵 Cash in hand" />
                    <TextBlock Grid.Row="1" Classes="balance" Text="{Binding CashBalanceText}"
                               Classes.negative="{Binding IsCashNegative}" />
                    <Button Grid.Row="2" Theme="{StaticResource TransparentButton}" Padding="4,2" Margin="-4,2,0,0"
                            HorizontalAlignment="Left" ToolTip.Tip="Change the opening balance">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding CashOpeningText}" FontSize="12" Opacity="0.8" />
                            <ui:SymbolIcon Symbol="Edit" FontSize="12" Opacity="0.8" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="280" Spacing="10">
                                    <TextBlock Text="Opening cash in hand" FontWeight="SemiBold" />
                                    <TextBlock Text="Count the cash you had at the start of the month. Otherwise it follows last month's closing figure."
                                               TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                                    <ui:NumberBox Value="{Binding OpeningCashInput, Mode=TwoWay}" SpinButtonPlacementMode="Hidden"
                                                  AcceptsExpression="True" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Opening cash in hand" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="accent" Content="Set" Command="{Binding SetCashOpeningCommand}" />
                                        <Button Content="Carry forward instead" Command="{Binding CarryCashOpeningCommand}"
                                                IsVisible="{Binding CashOpeningIsManual}" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding CashBreakdown}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="12" Opacity="0.7" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Warnings -->
        <StackPanel Grid.Row="2" Spacing="8">
            <ui:InfoBar IsOpen="{Binding HasBalanceWarning}" IsVisible="{Binding HasBalanceWarning}"
                        IsClosable="False" Severity="Warning" Message="{Binding BalanceWarning}" Margin="0,0,0,4" />
            <ui:InfoBar IsOpen="{Binding HasProblems}" IsVisible="{Binding HasProblems}"
                        IsClosable="False" Severity="Warning" Title="Some rows need fixing"
                        Message="These rows couldn't be read and aren't counted. Fix them in Excel, then reload." Margin="0,0,0,4">
                <ItemsControl ItemsSource="{Binding ProblemLines}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:InfoBar>
        </StackPanel>

        <!-- Log a withdrawal / deposit / income -->
        <Border Grid.Row="3" Classes="card" Padding="16" Margin="0,0,0,12">
            <StackPanel x:Name="EntryForm" Spacing="12">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="{Binding FormTitle}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </Grid>

                <ListBox Classes="segmented" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding EntryType}"
                         AutomationProperties.Name="Type">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BankCashTypeOption">
                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Explanation}">
                                <TextBlock Text="{Binding Icon}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid ColumnDefinitions="*,12,*,12,2*,12,Auto">
                    <StackPanel>
                        <TextBlock Classes="caption" Text="Amount (₨)" />
                        <ui:NumberBox x:Name="AmountBox" Value="{Binding EntryAmount, Mode=TwoWay}"
                                      AcceptsExpression="True" SpinButtonPlacementMode="Hidden"
                                      HorizontalAlignment="Stretch" PlaceholderText="e.g. 20000"
                                      AutomationProperties.Name="Amount" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="caption" Text="Date" />
                        <CalendarDatePicker SelectedDate="{Binding EntryDate}" HorizontalAlignment="Stretch"
                                            SelectedDateFormat="Custom" CustomDateFormatString="ddd, d MMM yyyy"
                                            AutomationProperties.Name="Date" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Classes="caption" Text="Note" />
                        <TextBox Text="{Binding EntryNote}" Watermark="Optional, e.g. ATM at Saddar, September salary"
                                 AutomationProperties.Name="Note" />
                    </StackPanel>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" />
                        <Button Classes="accent" Command="{Binding SaveEntryCommand}" MinWidth="110">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="Add" FontSize="16" IsVisible="{Binding !IsEditing}" />
                                <ui:SymbolIcon Symbol="Save" FontSize="16" IsVisible="{Binding IsEditing}" />
                                <TextBlock Text="{Binding SaveButtonText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ui:InfoBar IsOpen="{Binding HasError}" IsVisible="{Binding HasError}"
                            IsClosable="False" Severity="Error" Message="{Binding ErrorMessage}" />
            </StackPanel>
        </Border>

        <!-- Timeline header -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Text="Money in and out" Theme="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowExpenses}"
                          OnContent="Showing cash &amp; bank expenses" OffContent="Transactions only" />
        </Grid>

        <TextBlock Grid.Row="6" Text="Nothing yet this month. Log your salary or a withdrawal above, or add cash and bank expenses on the Expenses page."
                   Opacity="0.6" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,24" IsVisible="{Binding !HasRows}" />

        <DataGrid Grid.Row="6" x:Name="LedgerGrid"
                  ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}"
                  IsReadOnly="True" CanUserSortColumns="False" CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single"
                  DoubleTapped="OnGridDoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" x:DataType="vm:LedgerRowViewModel" Binding="{Binding DateText}" Width="110" />
                <DataGridTemplateColumn Header="Details" Width="2*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LedgerRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="12"
                                        Background="{Binding Color, Converter={x:Static views:AppConverters.HexToTint}}">
                                    <TextBlock Text="{Binding Icon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" VerticalAlignment="Center" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Bank" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LedgerRowViewModel">
                            <TextBlock Text="{Binding BankChangeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Cash" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LedgerRowViewModel">
                            <TextBlock Text="{Binding CashChangeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Bank balance" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LedgerRowViewModel">
                            <TextBlock Text="{Binding BankBalanceText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="12,0" FontWeight="SemiBold" Classes.negative="{Binding IsBankNegative}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Cash in hand" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LedgerRowViewModel">
                            <TextBlock Text="{Binding CashBalanceText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="12,0" FontWeight="SemiBold" Classes.negative="{Binding IsCashNegative}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="84" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:LedgerRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" Margin="0,0,8,0"
                                        IsVisible="{Binding IsEntry}">
                                <Button Theme="{StaticResource TransparentButton}"
                                        Command="{Binding $parent[DataGrid].((vm:BankCashViewModel)DataContext).BeginEditCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="Edit" AutomationProperties.Name="Edit transaction">
                                    <ui:SymbolIcon Symbol="Edit" FontSize="15" />
                                </Button>
                                <Button Theme="{StaticResource TransparentButton}"
                                        Command="{Binding $parent[DataGrid].((vm:BankCashViewModel)DataContext).DeleteCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete transaction">
                                    <ui:SymbolIcon Symbol="Delete" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
