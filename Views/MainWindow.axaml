<wnd:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:ui="using:FluentAvalonia.UI.Controls"
               xmlns:wnd="using:FluentAvalonia.UI.Windowing"
               xmlns:vm="using:HisaabKitaab.ViewModels"
               mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
               x:Class="HisaabKitaab.Views.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               Title="Hisaab Kitaab"
               Icon="/Assets/hisaab-kitaab.ico"
               Width="1200" Height="780"
               MinWidth="800" MinHeight="560"
               WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <ui:NavigationView x:Name="NavView"
                       PaneDisplayMode="Left"
                       PaneTitle="Hisaab Kitaab"
                       IsBackButtonVisible="False"
                       IsSettingsVisible="True"
                       OpenPaneLength="240"
                       SelectionChanged="OnNavSelectionChanged">
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="Dashboard" Tag="Dashboard">
                <ui:NavigationViewItem.IconSource>
                    <ui:PathIconSource Data="{StaticResource IconDashboard}" />
                </ui:NavigationViewItem.IconSource>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Expenses" Tag="Expenses">
                <ui:NavigationViewItem.IconSource>
                    <ui:PathIconSource Data="{StaticResource IconReceipt}" />
                </ui:NavigationViewItem.IconSource>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Bank &amp; Cash" Tag="BankCash">
                <ui:NavigationViewItem.IconSource>
                    <ui:PathIconSource Data="{StaticResource IconBank}" />
                </ui:NavigationViewItem.IconSource>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Currency" Tag="Currency">
                <ui:NavigationViewItem.IconSource>
                    <ui:PathIconSource Data="{StaticResource IconBanknote}" />
                </ui:NavigationViewItem.IconSource>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Credit Card" Tag="CreditCard">
                <ui:NavigationViewItem.IconSource>
                    <ui:PathIconSource Data="{StaticResource IconCreditCard}" />
                </ui:NavigationViewItem.IconSource>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Zakat" Tag="Zakat">
                <ui:NavigationViewItem.IconSource>
                    <ui:PathIconSource Data="{StaticResource IconHeart}" />
                </ui:NavigationViewItem.IconSource>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <!-- The page for the selected item, resolved to a view by ViewLocator -->
        <ContentControl Content="{Binding CurrentPage}" />
    </ui:NavigationView>
</wnd:AppWindow>
