<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:HisaabKitaab.ViewModels"
             xmlns:m="using:HisaabKitaab.Models"
             xmlns:views="using:HisaabKitaab.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="HisaabKitaab.Views.ExpensesView"
             x:DataType="vm:ExpensesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="32,24,32,16">

        <!-- Header: title and month navigation -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Theme="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{Binding Description}" Opacity="0.75" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsBusy}" />
                <Button Theme="{StaticResource TransparentButton}" Command="{Binding PreviousMonthCommand}"
                        ToolTip.Tip="Previous month" AutomationProperties.Name="Previous month">
                    <ui:SymbolIcon Symbol="ChevronLeft" FontSize="16" />
                </Button>
                <TextBlock Text="{Binding PeriodTitle}" Theme="{StaticResource SubtitleTextBlockStyle}"
                           MinWidth="180" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Theme="{StaticResource TransparentButton}" Command="{Binding NextMonthCommand}"
                        ToolTip.Tip="Next month" AutomationProperties.Name="Next month">
                    <ui:SymbolIcon Symbol="ChevronRight" FontSize="16" />
                </Button>
                <Button Content="This month" Command="{Binding GoToThisMonthCommand}"
                        IsVisible="{Binding !IsCurrentMonth}" />
                <Button Command="{Binding ReloadCommand}" ToolTip.Tip="Reload from file"
                        AutomationProperties.Name="Reload from file">
                    <ui:SymbolIcon Symbol="Refresh" FontSize="16" />
                </Button>
                <Button Command="{Binding OpenWorkbookCommand}" ToolTip.Tip="{Binding WorkbookName, StringFormat='Open {0}'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:SymbolIcon Symbol="OpenFile" FontSize="16" />
                        <TextBlock Text="Open in Excel" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Month totals -->
        <Border Grid.Row="1" Classes="card" Padding="20,12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="1.4*,*,*,*">
                <StackPanel>
                    <TextBlock Classes="caption" Text="{Binding CountText}" />
                    <TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <TextBlock Classes="caption" Text="💵 Cash" />
                    <TextBlock Classes="statValue" Text="{Binding CashText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Classes="caption" Text="🏦 Bank" />
                    <TextBlock Classes="statValue" Text="{Binding BankText}" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <TextBlock Classes="caption" Text="💳 Credit Card" />
                    <TextBlock Classes="statValue" Text="{Binding CardText}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <!-- Recurring expenses added automatically since the page was last shown -->
            <ui:InfoBar Margin="0,0,0,12"
                        IsOpen="{Binding HasRecurringNotice}" IsVisible="{Binding HasRecurringNotice}"
                        IsClosable="True" CloseButtonCommand="{Binding DismissRecurringNoticeCommand}"
                        Severity="Informational" Title="Recurring"
                        Message="{Binding RecurringNotice}" />

            <!-- Rows in the workbook that couldn't be read -->
            <ui:InfoBar Margin="0,0,0,12"
                        IsOpen="{Binding HasProblems}" IsVisible="{Binding HasProblems}"
                        IsClosable="False" Severity="Warning"
                        Title="Some rows need fixing"
                        Message="{Binding ProblemSummary}">
                <ui:InfoBar.ActionButton>
                    <Button Content="Open in Excel" Command="{Binding OpenWorkbookCommand}" />
                </ui:InfoBar.ActionButton>
                <ItemsControl ItemsSource="{Binding ProblemLines}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:InfoBar>
        </StackPanel>

        <!-- Quick add / edit form -->
        <Border Grid.Row="3" Classes="card" Padding="16" Margin="0,0,0,12">
            <StackPanel x:Name="EntryForm" Spacing="12">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="{Binding FormTitle}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </Grid>

                <Grid ColumnDefinitions="*,12,1.3*,12,*,12,*">
                    <StackPanel>
                        <TextBlock Classes="caption" Text="Amount (₨)" />
                        <ui:NumberBox x:Name="AmountBox"
                                      Value="{Binding EntryAmount, Mode=TwoWay}"
                                      AcceptsExpression="True"
                                      SpinButtonPlacementMode="Hidden"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="e.g. 450 or 250+200"
                                      AutomationProperties.Name="Amount" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="caption" Text="Category" />
                        <ComboBox ItemsSource="{Binding CategoryOptions}"
                                  SelectedItem="{Binding EntryCategory}"
                                  PlaceholderText="Category"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Category">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryOption">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="22" Height="22" CornerRadius="11"
                                                Background="{Binding Color, Converter={x:Static views:AppConverters.HexToTint}}">
                                            <TextBlock Text="{Binding Icon}" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Classes="caption" Text="Family member" />
                        <ComboBox ItemsSource="{Binding MemberOptions}"
                                  SelectedItem="{Binding EntryMember}"
                                  PlaceholderText="Who?"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Family member" />
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Classes="caption" Text="Date" />
                        <CalendarDatePicker SelectedDate="{Binding EntryDate}"
                                            SelectedDateFormat="Custom"
                                            CustomDateFormatString="ddd, d MMM yyyy"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Date" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                    <StackPanel>
                        <TextBlock Classes="caption" Text="Paid with" />
                        <ListBox Classes="segmented"
                                 ItemsSource="{Binding PaymentOptions}"
                                 SelectedItem="{Binding EntryPayment}"
                                 AutomationProperties.Name="Paid with">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaymentOption">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Icon}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="caption" Text="Note" />
                        <TextBox Text="{Binding EntryNote}" Watermark="Optional, e.g. milk and eggs"
                                 AutomationProperties.Name="Note" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" />
                        <Button Classes="accent" Command="{Binding SaveEntryCommand}" MinWidth="110"
                                ToolTip.Tip="Enter">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="Add" FontSize="16" IsVisible="{Binding !IsEditing}" />
                                <ui:SymbolIcon Symbol="Save" FontSize="16" IsVisible="{Binding IsEditing}" />
                                <TextBlock Text="{Binding SaveButtonText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ui:InfoBar IsOpen="{Binding HasError}" IsVisible="{Binding HasError}"
                            IsClosable="False" Severity="Error"
                            Message="{Binding ErrorMessage}" />

                <!-- The expense just saved took a budget near or over its limit -->
                <ui:InfoBar IsOpen="{Binding HasBudgetWarning}" IsVisible="{Binding HasBudgetWarning}"
                            IsClosable="False" Severity="Warning"
                            Message="{Binding BudgetWarning}" />

                <TextBlock FontSize="12" Opacity="0.6" IsVisible="{Binding !HasMembers}"
                           Text="Tip: add your family members in Settings to pick who spent it." />
            </StackPanel>
        </Border>

        <!-- Search box and filter toggle -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText}"
                     Watermark="Search notes, categories, people, amounts…  (Ctrl+F)"
                     Classes="clearButton"
                     AutomationProperties.Name="Search expenses">
                <TextBox.InnerLeftContent>
                    <ui:SymbolIcon Symbol="Find" FontSize="16" Margin="10,0,2,0" Opacity="0.7" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <ToggleButton Grid.Column="1" Margin="8,0,0,0"
                          IsChecked="{Binding IsFilterPanelOpen}"
                          AutomationProperties.Name="Show filters">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Filter" FontSize="16" />
                    <TextBlock Text="{Binding FilterButtonText}" />
                </StackPanel>
            </ToggleButton>
            <Button Grid.Column="2" Margin="8,0,0,0"
                    Content="Clear filters"
                    Command="{Binding ClearFiltersCommand}"
                    IsVisible="{Binding HasActiveFilters}" />
        </Grid>

        <!-- Filters: period, people, categories, payment method, amount -->
        <Border Grid.Row="5" Classes="card" Padding="16,12" Margin="0,0,0,8"
                IsVisible="{Binding IsFilterPanelOpen}">
            <StackPanel Spacing="12">
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Classes="caption" Text="From" />
                        <CalendarDatePicker SelectedDate="{Binding RangeFrom}" Width="170"
                                            SelectedDateFormat="Custom" CustomDateFormatString="d MMM yyyy"
                                            AutomationProperties.Name="From date" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Classes="caption" Text="To" />
                        <CalendarDatePicker SelectedDate="{Binding RangeTo}" Width="170"
                                            SelectedDateFormat="Custom" CustomDateFormatString="d MMM yyyy"
                                            AutomationProperties.Name="To date" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                        <Button Content="This month" Command="{Binding GoToThisMonthCommand}" />
                        <Button Content="Last 30 days" Command="{Binding ShowLast30DaysCommand}" />
                        <Button Content="This year" Command="{Binding ShowThisYearCommand}" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding RangeError}" IsVisible="{Binding HasRangeError}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="caption" Text="Family member" />
                        <DropDownButton MinWidth="170" Content="{Binding MemberFilterText}"
                                        AutomationProperties.Name="Filter by family member">
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsControl ItemsSource="{Binding MemberChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FilterChoiceViewModel">
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="caption" Text="Category" />
                        <DropDownButton MinWidth="170" Content="{Binding CategoryFilterText}"
                                        AutomationProperties.Name="Filter by category">
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsControl ItemsSource="{Binding CategoryChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FilterChoiceViewModel">
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="caption" Text="Paid with" />
                        <DropDownButton MinWidth="170" Content="{Binding PaymentFilterText}"
                                        AutomationProperties.Name="Filter by payment method">
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ItemsControl ItemsSource="{Binding PaymentChoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FilterChoiceViewModel">
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="caption" Text="Amount (₨)" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:NumberBox Value="{Binding MinAmount, Mode=TwoWay}" Width="110"
                                          PlaceholderText="Min" SpinButtonPlacementMode="Hidden"
                                          AutomationProperties.Name="Minimum amount" />
                            <TextBlock Text="to" VerticalAlignment="Center" Opacity="0.7" />
                            <ui:NumberBox Value="{Binding MaxAmount, Mode=TwoWay}" Width="110"
                                          PlaceholderText="Max" SpinButtonPlacementMode="Hidden"
                                          AutomationProperties.Name="Maximum amount" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- The period's expenses (after filters), newest first -->
        <TextBlock Grid.Row="6" Text="{Binding EmptyText}" Opacity="0.6"
                   HorizontalAlignment="Center" Margin="0,32"
                   IsVisible="{Binding !HasRows}" />

        <DataGrid Grid.Row="6" x:Name="ExpensesGrid"
                  ItemsSource="{Binding Rows}"
                  IsVisible="{Binding HasRows}"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  DoubleTapped="OnGridDoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" x:DataType="vm:ExpenseRowViewModel"
                                    Binding="{Binding DateText}" SortMemberPath="Date" Width="110" />
                <DataGridTemplateColumn Header="Category" SortMemberPath="CategoryName" Width="1.2*" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ExpenseRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="12"
                                        Background="{Binding Category.Color, Converter={x:Static views:AppConverters.HexToTint}}">
                                    <TextBlock Text="{Binding Category.Icon}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding CategoryName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Member" x:DataType="vm:ExpenseRowViewModel"
                                    Binding="{Binding Member}" SortMemberPath="Member" Width="*" MinWidth="100" />
                <DataGridTemplateColumn Header="Amount" SortMemberPath="Amount" Width="115">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ExpenseRowViewModel">
                            <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Paid with" SortMemberPath="PaymentName" Width="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ExpenseRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Payment.Icon}" />
                                <TextBlock Text="{Binding PaymentName}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Note" x:DataType="vm:ExpenseRowViewModel"
                                    Binding="{Binding Note}" Width="1.8*" MinWidth="120" />
                <DataGridTemplateColumn Width="84" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ExpenseRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" Margin="0,0,8,0">
                                <Button Theme="{StaticResource TransparentButton}"
                                        Command="{Binding $parent[DataGrid].((vm:ExpensesViewModel)DataContext).BeginEditCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Edit" AutomationProperties.Name="Edit expense">
                                    <ui:SymbolIcon Symbol="Edit" FontSize="15" />
                                </Button>
                                <Button Theme="{StaticResource TransparentButton}"
                                        Command="{Binding $parent[DataGrid].((vm:ExpensesViewModel)DataContext).DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Delete" AutomationProperties.Name="Delete expense">
                                    <ui:SymbolIcon Symbol="Delete" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
