<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Outline icons on a 24x24 grid, drawn with even-odd fill (F0) so inner
        shapes punch holes. Used for navigation items that FluentAvalonia's
        built-in Symbol set doesn't cover.
    -->
